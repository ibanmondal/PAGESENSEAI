# Copy to .env and fill in. Everything is optional except the LLM keys you use.

# --- App ---
APP_ENV=dev
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- LLM providers (set at least one) ---
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Model routing ---
FAST_MODEL=gemini-2.5-flash
STRONG_MODEL=gpt-4.1

# --- Retrieval ---
BM25_WEIGHT=0.35
DENSE_WEIGHT=0.65
TOP_K_RETRIEVAL=20
TOP_K_RERANK=5

# --- Re-ranker ---
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Set this to your fine-tuned weights dir to use them in the live pipeline:
# RERANKER_FINETUNED_PATH=eval/artifacts/reranker_finetuned

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Chunking ---
CHUNK_SIZE=400
CHUNK_OVERLAP=60
